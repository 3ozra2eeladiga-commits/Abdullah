# Скопируйте этот файл в .env и заполните. Файл .env никому не отправляйте!

# ---------- «Мозг» (ИИ): yandex | gigachat | claude ----------
LLM_PROVIDER=yandex

# YandexGPT (console.yandex.cloud)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# yandexgpt-lite/latest — дешёвая, yandexgpt/latest — умнее и дороже
YANDEX_MODEL=yandexgpt-lite/latest

# GigaChat (developers.sber.ru) — «Ключ авторизации»
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Pro
GIGACHAT_CA_BUNDLE=/opt/flowerbot/russian_trusted_root_ca.pem

# Claude (console.anthropic.com) — только если вы в стране, где он доступен
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# ---------- Telegram (пульт для сотрудников) ----------
TELEGRAM_TOKEN=
# ID сотрудников через запятую (узнать: написать боту /start)
TELEGRAM_STAFF_IDS=
# ID группы для заказов (необязательно). Если пусто — заказы приходят каждому сотруднику.
TELEGRAM_ORDERS_CHAT=

# ---------- Instagram (заполним на этапе подключения) ----------
IG_ACCESS_TOKEN=
IG_APP_SECRET=
# Любое придуманное слово, его же вставите в настройках Meta
IG_VERIFY_TOKEN=
IG_API_VERSION=v21.0

# ---------- Сервер ----------
# Адрес сервера, например https://123-45-67-89.sslip.io
PUBLIC_BASE_URL=
PORT=8080

# ---------- Магазин ----------
CITY_SITES=Пятигорск=https://naromashke.ru,Минеральные Воды=https://mw.naromashke.ru
SHOP_INFO_FILE=shop/shop_info.md
