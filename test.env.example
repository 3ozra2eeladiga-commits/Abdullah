# Настройки для ТЕСТА на ноутбуке (только Telegram, без Инстаграма).
# Впишите значения после знака = без пробелов и кавычек. Файл никому не отправляйте!

LLM_PROVIDER=yandex
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-lite/latest

TELEGRAM_TOKEN=
# Сначала оставьте пустым. Запустите бота, напишите ему /start — он пришлёт ваш ID. Впишите его сюда.
TELEGRAM_STAFF_IDS=

# Секретный код (необязательно): написали боту этот код — бот присылает SECRET_REPLY. Только здесь, не в GitHub.
# SECRET_CODE=придумайте-сложный-код
# SECRET_REPLY=Текст ответа\nВторая строка
