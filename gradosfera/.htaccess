AddDefaultCharset UTF-8
DirectoryIndex index.html
Options -Indexes

# HTTPS включается в панели Timeweb (SSL-сертификаты → «Перенаправлять на HTTPS»).
# Если нужно через .htaccess — раскомментируйте (на Timeweb HTTPS приходит через прокси):
# RewriteEngine On
# RewriteCond %{HTTP:X-Forwarded-Proto} !=https
# RewriteRule .* https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Закрыть служебные файлы
<FilesMatch "^(config\.php|config\.example\.php|README\.md|\.gitignore)$">
  Require all denied
</FilesMatch>

# Кеширование статики
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType application/pdf "access plus 30 days"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
AddType image/webp .webp
